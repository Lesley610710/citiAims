---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About us',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About us"
    image={{
      src: 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80',
      alt: 'Asset management team collaboration',
    }}
  >
    <Fragment slot="title">
      Empowering asset-intensive organisations with
      <span class="text-accent dark:text-white"> smarter asset operations</span>
    </Fragment>

    <Fragment slot="subtitle">
      citiAims brings asset data, maintenance execution and performance insight together in one digital platform so teams can act with confidence.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Our impact"
    stats={[
      { title: 'Organisations supported', amount: '170+' },
      { title: 'Assets managed', amount: '200K+' },
      { title: 'Work orders logged', amount: '1.1M+' },
      { title: 'Customer satisfaction', amount: '98%' },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="What we do"
    subtitle="We help operational teams improve uptime, reduce risk, and make smarter decisions from asset lifecycle to maintenance delivery."
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'Asset intelligence',
        description:
          'Create a single source of truth for equipment, facilities and infrastructure to support planning and execution across teams.',
        icon: 'tabler:database',
      },
      {
        title: 'Maintenance excellence',
        description:
          'Standardise work orders, inspections and approvals so field crews can complete tasks consistently and safely.',
        icon: 'tabler:settings',
      },
      {
        title: 'Performance insight',
        description:
          'Turn operational data into dashboards and reports that highlight risk, cost and reliability opportunities.',
        icon: 'tabler:chart-bar',
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    columns={3}
    isAfterContent={true}
    items={[
      {
        title: 'Connected teams',
        description:
          'Office, field and service partners stay aligned with shared asset context, work status and priorities.',
        icon: 'tabler:users',
      },
      {
        title: 'Compliance-ready records',
        description:
          'Maintain audit trails for safety checks, inspections and service work so your organisation is ready for review.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Scaled deployment',
        description:
          'Start with core asset operations and extend to capital planning, sustainability and enterprise integration.',
        icon: 'tabler:building-warehouse',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1522202176988-66273c2fd55f?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80',
      alt: 'Professionals reviewing asset performance dashboards',
    }}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Our approach"
    subtitle="We work with organisations to align people, processes and technology around asset performance and operational resilience."
    items={[
      {
        title: 'Discover',
        description:
          'Understand your asset portfolio, workflows and reporting priorities so the solution supports real business needs.',
      },
      {
        title: 'Deploy',
        description:
          'Configure the platform, train teams and start using standardised processes across sites and asset classes.',
      },
      {
        title: 'Optimise',
        description:
          'Use workflow data and insights to continually improve operations, reduce downtime and manage cost. ',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <Features2
    title="Talk to our team"
    subtitle="Let us show you how citiAims can support your asset operations and improve your maintenance outcomes."
    columns={2}
    items={[
      {
        title: 'Expert consultation',
        description: 'Discuss your asset strategy and discover the right deployment path for your organisation.',
      },
      {
        title: 'Implementation support',
        description: 'Plan rollout, integrations and onboarding to get value from the platform faster.',
      },
    ]}
  />
</Layout>
