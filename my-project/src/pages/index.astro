---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'citiAims — Asset intelligence platform',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Talk to an expert',
        href: '/contact',
        icon: 'tabler:phone',
      },
      { text: 'See solution details', href: '/solution' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'citiAims Hero Image' }}
  >
    <Fragment slot="title">
      Unlock intelligent asset operations with
      <span class="text-accent dark:text-white"> citiAims</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        citiAims empowers asset-intensive organisations to manage infrastructure, maintenance, and performance from a single digital platform.
      </span>
      <span class="block mb-1 sm:hidden font-bold text-blue-600">citiAims brings asset intelligence to your team.</span>
      Connect people, places, and assets with confidence.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note title="Philosophy:" description="Connected asset intelligence, trusted operational workflows, and measurable outcomes." />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Capabilities"
    title="Why organisations choose citiAims"
    subtitle="A unified platform built to help teams manage assets, maintenance, compliance, and performance with clarity."
    items={[
      {
        title: 'Asset lifecycle visibility',
        description:
          'Track every asset from acquisition through retirement so teams can make smarter decisions at every stage.',
        icon: 'tabler:eye',
      },
      {
        title: 'Predictive maintenance planning',
        description:
          'Anticipate service needs, reduce downtime, and extend asset life with data-driven maintenance workflows.',
        icon: 'tabler:calendar-event',
      },
      {
        title: 'Real-time performance analytics',
        description:
          'Understand asset health, utilisation, and costs through dashboards that highlight the metrics that matter.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'Mobile field collaboration',
        description:
          'Field teams stay connected with work orders, inspections, and asset history available anytime, anywhere.',
        icon: 'tabler:device-mobile',
      },
      {
        title: 'Compliance and audit readiness',
        description:
          'Document activity, manage risk, and keep stakeholders aligned with transparent operational records.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Configurable workflows',
        description:
          'Adapt citiAims to your organisation with flexible asset categories, approval flows, and reporting preferences.',
        icon: 'tabler:settings',
      },
    ]}
  />

  <!-- citiAims Platform Overview Widget ****** -->

  <Content
    isAfterContent
    tagline="Platform"
    title="How citiAims transforms asset-intensive operations"
    subtitle="A unified asset intelligence platform built for teams that need visibility, reliability, and sustainable performance."
    items={[
      {
        title: 'Connected asset register',
        description:
          'Maintain a single source of truth for equipment, facilities, systems, and infrastructure across the organisation.',
      },
      {
        title: 'Operational dashboards',
        description:
          'Bring work orders, inspections, spend, and asset condition into one place for faster decisions.',
      },
      {
        title: 'Field-friendly workflows',
        description:
          'Empower crews with mobile-ready tools that support inspections, service requests, and field updates in real time.',
      },
      {
        title: 'Sustainability and compliance',
        description:
          'Track performance against operational standards, sustainability goals, and budget targets with confidence.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1535378917047-0c7a9844b340?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80',
      alt: 'Asset management dashboard overview',
    }}
  >
    <Fragment slot="content">
      citiAims helps organisations streamline maintenance, capital planning, and asset performance by connecting people, processes, and data in a secure platform.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="Approach"
    title="A modern foundation for asset and facilities teams"
    items={[
      {
        title: 'Reliable digital workflows',
        description:
          'Standardise maintenance, inspections, and approvals so teams can work consistently and efficiently.',
      },
      {
        title: 'Clear operational insights',
        description:
          'Turn asset data into actionable priorities with visual analytics and easy-to-understand metrics.',
      },
      {
        title: 'Scalable implementation',
        description:
          'Start with core operations and expand into capital planning, sustainability, and mobile service execution.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Operational dashboard and team collaboration',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Built for operational confidence</h3>
      citiAims combines strong data, field collaboration, and reporting so organisations can manage assets with complete visibility.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Flexible configuration',
        description:
          'Adapt citiAims to your operational model with asset categories, service types, and approval flows that fit your organisation.',
      },
      {
        title: 'Mobile-ready field access',
        description:
          'Give technicians and inspectors the tools they need to update work orders, capture notes, and close tasks from the field.',
      },
      {
        title: 'Performance-driven reporting',
        description:
          'Surface the KPIs that matter most so leaders can spot trends, manage budgets, and improve asset uptime.',
      },
      {
        title: 'Secure operational control',
        description:
          'Protect asset data with role-based access while keeping processes transparent and audit-ready.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
      alt: 'Operational blueprint and planning',
    }}
  >
    <Fragment slot="content">Build asset operations that scale with your organisation and deliver measurable business outcomes.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Operational resilience',
        description:
          'Give teams the structure and visibility they need to reduce downtime and keep critical assets performing reliably.',
      },
      {
        title: 'Continuous process improvement',
        description:
          'Use performance data to refine maintenance plans, reduce cost, and extend asset life across your portfolio.',
      },
      {
        title: 'Fast time to value',
        description:
          'Deploy a practical platform quickly and begin capturing efficiency gains from day one.',
      },
      {
        title: 'Collaboration across teams',
        description:
          'Align operations, maintenance, and leadership with shared insights and a common asset management experience.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Collaborative field operations image',
    }}
  >
    <Fragment slot="content">Designed to keep teams aligned, assets monitored, and operations moving forward.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="Start your asset intelligence journey with citiAims."
    items={[
      {
        title: 'Step 1: <span class="font-medium">Assess asset needs</span>',
        description:
          'Map your asset portfolio, critical systems, and maintenance priorities so citiAims can be configured for your operation.',
        icon: 'tabler:search',
      },
      {
        title: 'Step 2: <span class="font-medium">Deploy the platform</span>',
        description:
          'Set up asset registers, workflows, and dashboards quickly so your team can work from a single trusted source.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Step 3: <span class="font-medium">Drive performance</span>',
        description:
          'Use maintenance plans, inspections, and analytics to reduce risk, improve uptime, and align operations with budgets.',
        icon: 'tabler:trending-up',
      },
      {
        title: 'Ready to scale',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Steps image',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Core capabilities"
    subtitle="Essential platform modules that support asset operations, maintenance, and planning"
    tagline="Capabilities"
    items={[
      {
        title: 'Asset register',
        description: 'A central repository for equipment, locations, models, and lifecycle history.',
        icon: 'flat-color-icons:database',
      },
      {
        title: 'Work orders',
        description: 'Create, assign, and track service requests from initiation through completion.',
        icon: 'flat-color-icons:document',
      },
      {
        title: 'Inspections',
        description: 'Capture audit findings, safety checks, and condition reports in the field.',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'Analytics',
        description: 'Visualise downtime, spend, and asset trends with actionable dashboards.',
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'Mobile access',
        description: 'Field teams stay productive with responsive tools and offline-ready workflows.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'Approvals',
        description: 'Streamline authorisations for repairs, purchases, and capital projects.',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'Compliance',
        description: 'Document work and asset activity to support audits and regulatory reporting.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'Integrations',
        description: 'Connect citiAims with finance, GIS, and enterprise systems for smoother operations.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'Support',
        description: 'Access resources and guidance to keep your implementation running smoothly.',
        icon: 'flat-color-icons:business-contact',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Frequently Asked Questions"
    subtitle="Answers to common questions about citiAims and how it supports asset operations."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'What does citiAims do?',
        description:
          'citiAims centralises asset records, maintenance planning, inspections, and performance reporting to help teams operate more efficiently.',
      },
      {
        title: 'Who is citiAims for?',
        description:
          'Organisations with asset-intensive operations, such as facilities, infrastructure, and maintenance teams, benefit most from the platform.',
      },
      {
        title: 'How quickly can we get started?',
        description:
          'You can begin with a core asset and maintenance configuration, then expand into analytics and sustainability tracking as your team adopts the platform.',
      },
      {
        title: 'Can we access it from the field?',
        description:
          'Yes. citiAims is designed for mobile access so field crews can complete work orders, capture inspections, and update asset status on the go.',
      },
      {
        title: 'Does it support compliance and audits?',
        description:
          'The platform records work activity, asset history, and approvals to help you stay audit-ready and maintain regulatory compliance.',
      },
      {
        title: 'How does citiAims support better decision-making?',
        description:
          'By combining asset data with operational metrics, the platform helps leaders identify opportunities to reduce downtime, control costs, and improve performance.',
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    title="Enterprise asset performance"
    stats={[
      { title: 'Assets monitored', amount: '200K+' },
      { title: 'Work orders completed', amount: '1.1M+' },
      { title: 'Sites supported', amount: '360+' },
      { title: 'Customer satisfaction', amount: '98%' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Book a demo',
        href: '/contact',
        icon: 'tabler:rocket',
      },
    ]}
  >
    <Fragment slot="title">
      Deliver smarter asset outcomes with citiAims
    </Fragment>

    <Fragment slot="subtitle">
      Empower your teams to manage assets, maintenance, and performance from one trusted platform.
    </Fragment>
  </CallToAction>
</Layout>
