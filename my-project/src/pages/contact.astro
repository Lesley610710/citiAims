---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact us',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact us" title="Speak with our asset management specialists" />

  <ContactUs
    id="form"
    title="Drop us a message today"
    subtitle="Whether you need enterprise asset management advice, implementation support, or want to discuss your operational goals, our team is ready to help."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
      {
        type: 'text',
        name: 'company',
        label: 'Company',
      },
    ]}
    textarea={{
      label: 'Tell us about your requirements',
    }}
    disclaimer={{
      label:
        'By submitting this contact form, you acknowledge and agree to the collection of your personal information for follow-up purposes.',
    }}
    description="Our team typically responds within one business day."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="How we can help"
    items={[
      {
        title: 'Enterprise asset management',
        description:
          'Get expert guidance on how citiAims can help you manage assets, maintenance, compliance, and performance from one platform.',
      },
      {
        title: 'Implementation support',
        description:
          'Discuss rollout, integrations, training and change management for your asset operations team.',
      },
      {
        title: 'Customer success',
        description:
          'Find out how we support customers through onboarding, optimisation and long-term adoption.',
      },
      {
        title: 'Phone',
        description: '+1 (234) 567-890',
        icon: 'tabler:headset',
      },
      {
        title: 'Email',
        description: 'hello@citiaims.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Location',
        description: 'Global support with local advisory services for asset-intensive organisations.',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
